    "testing": {
        "cases": [
            "no recibe foco ni emite eventos",
            "el texto no se corta ni se envuelve (nowrap)",
            "cada variant × color × highContrast usa los tokens de tokens.bindings",
            "highContrast usa el paso 12 (o el 1 sobre solid) en todas las variantes y colores",
            "solid usa black-contrast en warning, info, sky, mint, lime, yellow y amber; accent-contrast en accent; white-contrast en el resto",
            "el icono solo se pinta si se pasa icon, y usa el tamaño de layout.iconSize según size",
            "la altura resulta de 20 / 24 / 28 px según size, sin icono y con él"
        ]
    },
