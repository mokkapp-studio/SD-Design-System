    "a11y": {
        "role": "Ninguno propio: es texto en un <span>, no un control.",
        "name": "El texto (children). Si hay icono, es decorativo: el texto ya dice lo mismo.",
        "keyboard": [],
        "focusIndicator": "No recibe foco: no es interactivo. Si hace falta que se pueda pulsar, usa Button o Link.",
        "minTarget": "No aplica: no es interactivo.",
        "contrastNote": "Texto sobre fondo ≥ 4.5:1 (WCAG 1.4.3). No medido en Figma. Mirar con más cuidado soft, surface y outline en colores claros (amber, yellow, lime, mint, sky). solid usa white-contrast o black-contrast según el color.",
        "wcag": [
            "1.3.1 Información y relaciones",
            "1.4.1 Uso del color",
            "1.4.3 Contraste (AA)"
        ]
