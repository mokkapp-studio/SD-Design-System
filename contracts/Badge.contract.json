            "unit": "px",
            "token": null,
            "note": "Alto = padding vertical + altura de línea del texto (2+16+2, 4+16+4 y 4+20+4). No hay token de altura: resulta del layout."
        },
        "width": {
            "default": "hug",
            "modes": {
                "hug": "Se ajusta al texto más el padding horizontal y el icono si lo hay. Siempre; no hay fill ni fixed."
            },
            "min": null,
            "max": null,
            "note": "En Figma, con el texto de ejemplo «Badge»: 49 / 53 / 63 px sin icono visible."
        },
        "autoLayout": {
            "direction": "HORIZONTAL",
            "sizingHorizontal": "HUG",
            "sizingVertical": "HUG",
            "alignMain": "CENTER",
            "alignCross": "CENTER",
            "gap": "Por size: 6 / 6 / 8 px, entre icono y texto. Solo size 3 lo enlaza a una variable (spacing.2)."
        },
        "padding": {
            "values": {
                "1": "2px 6px",
                "2": "4px 8px",
                "3": "4px 10px"
            },
            "unit": "px",
            "note": "Formato vertical horizontal. En Figma solo el vertical de size 2 y 3 (spacing.1) y el horizontal de size 2 (spacing.2) están enlazados a variables; el resto son valores sueltos."
        },
        "iconSize": {
            "values": {
                "1": 12,
                "2": 16,
                "3": 16
            },
            "unit": "px",
            "note": "En size 2 y 3 el icono enlaza ancho y alto a spacing.4."
        },
        "fontSize": {
            "values": {
                "1": 12,
                "2": 12,
                "3": 14
            },
            "unit": "px",
            "note": "Deducido de los estilos text-style.1 y text-style.2 (los mismos que usa Link); no leído aquí."
        }
    },
    "behavior": {
