                "maxItems": 1,
                "mandatory": false,
                "figmaProp": "⮑ 🔄 iconStart"
            }
        },
        "label": {
            "element": "span",
            "description": "Texto del Badge.",
            "figmaLayer": "Badge (capa de texto)",
            "content": {
                "prop": "children"
            }
        }
    },
