{
  "$schema": "./component.schema.json",
  "id": "button",
  "name": "Button",
  "version": "2.0.0",
  "status": "draft",
  "category": "action",
  "description": "Lanza una acción cuando la persona lo pulsa. Se elige el énfasis con `variant`, el significado con `color` y se puede reforzar el contraste con `highContrast`.",
  "guidance": {
    "dos": [
      "Una sola acción principal por vista: `variant=\"solid\"` (o `classic`) con `color=\"accent\"`.",
      "Etiqueta con un verbo y un objeto: «Guardar cambios», no «Aceptar».",
      "Usa `color=\"error\"` solo para acciones destructivas y pide confirmación si no se pueden deshacer.",
      "Usa `highContrast` cuando necesites más contraste que el que da el color de acento.",
      "Jerarquía de énfasis de mayor a menor: solid/classic → soft/surface → outline → ghost."
    ],
    "donts": [
      {
        "case": "Navegación pura entre páginas",
        "useInstead": "Link",
        "why": "Un enlace se puede abrir en pestaña nueva, copiar y lo anuncia el lector de pantalla como enlace."
      },
      {
        "case": "Estado que persiste (activado / desactivado)",
        "useInstead": "Toggle o Checkbox",
        "why": "Un botón ejecuta, no mantiene estado."
      },
      {
        "case": "Botón solo con icono",
        "useInstead": "IconButton",
        "why": "Exige nombre accesible y tiene medidas propias; el Button de Figma siempre lleva etiqueta."
      },
      {
        "case": "Dos botones solid/classic con color accent en la misma vista",
        "useInstead": "Uno solid y el resto soft, outline o ghost",
        "why": "Si todo destaca, nada destaca."
      },
      {
        "case": "Enviar un formulario sin declararlo",
        "useInstead": "type='submit' explícito",
        "why": "El valor por defecto es type='button' para evitar envíos accidentales."
      }
    ],
    "related": [
      {
        "component": "Link",
        "relation": "similar",
        "difference": "Navega a otra página o recurso; el botón ejecuta una acción."
      },
      {
        "component": "Toggle",
        "relation": "similar",
        "difference": "Mantiene estado pulsado (aria-pressed)."
      },
      {
        "component": "IconButton",
        "relation": "alternative",
        "difference": "Solo icono; exige nombre accesible."
      }
    ]
  },
  "semantics": {
    "element": "button",
    "role": null,
    "refTarget": "root",
    "elementByProp": null
  },
  "props": [
    {
      "name": "variant",
      "type": "'classic' | 'solid' | 'soft' | 'surface' | 'outline' | 'ghost'",
      "default": "solid",
      "description": "Énfasis visual. solid = relleno pleno; classic = relleno con degradado y borde; soft = relleno tenue; surface = borde con fondo suave; outline = solo borde; ghost = sin relleno ni borde hasta hover.",
      "bindings": {
        "figma": {
          "property": "variant",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "color",
      "type": "'accent' | 'neutral' | 'error'",
      "default": "accent",
      "description": "Significado cromático. accent = color de marca; neutral = gris; error = acción destructiva.",
      "bindings": {
        "figma": {
          "property": "color",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "size",
      "type": "'1' | '2' | '3' | '4'",
      "default": "2",
      "description": "Tamaño físico: altura 24 / 32 / 40 / 48 px, y con ello padding, texto, gap y radio. El 2 es el valor por defecto.",
      "bindings": {
        "figma": {
          "property": "size",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "highContrast",
      "type": "boolean",
      "default": false,
      "description": "Si es true, refuerza el contraste: usa el paso 12 de la escala en lugar del 9/11. En Figma el eje se llama «highConstrast» (errata del archivo).",
      "bindings": {
        "figma": {
          "property": "highConstrast",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "loading",
      "type": "boolean",
      "default": false,
      "description": "Si es true, la acción está en curso: un spinner sustituye a icono y etiqueta, el ancho no cambia y no se puede pulsar.",
      "bindings": {
        "figma": {
          "property": "loading",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "Si es true, el botón no es interactivo. En Figma es el valor «disable» del eje `state`.",
      "bindings": {
        "figma": {
          "property": "state",
          "type": "VARIANT",
          "value": "disable"
        }
      }
    },
    {
      "name": "icon",
      "type": "ReactNode | undefined",
      "default": null,
      "description": "Icono inicial (en Figma, iconStart). Tamaño por size: 16 / 16 / 18 / 20 px. aria-hidden porque la etiqueta ya describe la acción.",
      "usage": "icon={<Plus />}",
      "bindings": {
        "figma": {
          "property": "⮑ 🔄 iconStart",
          "type": "INSTANCE_SWAP"
        }
      }
    },
    {
      "name": "iconEnd",
      "type": "ReactNode | undefined",
      "default": null,
      "description": "Icono final. Mismos tamaños que icon.",
      "usage": "iconEnd={<ArrowRight />}",
      "bindings": {
        "figma": {
          "property": "⮑ 🔄 iconEnd",
          "type": "INSTANCE_SWAP"
        }
      }
    },
    {
      "name": "type",
      "type": "'button' | 'submit' | 'reset'",
      "default": "button",
      "description": "Tipo nativo del botón. Solo de código. Usa 'submit' de forma explícita para enviar formularios.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "description": "Contenido de la etiqueta. Texto por defecto en Figma: «Button».",
      "bindings": {
        "figma": {
          "property": "✏️ text",
          "type": "TEXT"
        }
      }
    },
    {
      "name": "onPress",
      "type": "(event: MouseEvent<HTMLButtonElement>) => void",
      "default": null,
      "description": "Manejador de pulsación (ratón, teclado o toque). Solo de código.",
      "bindings": {
        "figma": null
      }
    }
  ],
  "states": {
    "native": [
      "hover",
      "focus-visible",
      "active"
    ],
    "controlled": [
      {
        "name": "loading",
        "description": "La acción lanzada está en curso. No es interactivo y muestra un spinner en lugar del contenido.",
        "aria": "aria-busy='true'"
      },
      {
        "name": "disabled",
        "description": "No es interactivo. La opción existe pero ahora no está disponible. Se pinta con tokens neutros (neutral-alpha), nunca con opacity.",
        "aria": "disabled (atributo HTML nativo)"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "button",
      "description": "Elemento interactivo raíz. Siempre un <button> nativo.",
      "figmaLayer": "Button (cada variante del component set)"
    },
    "focusRing": {
      "element": "css",
      "description": "No es un elemento: se pinta con :focus-visible. En Figma es una capa que se muestra con el boolean focusRing: borde exterior de 4px e interior de 2px.",
      "optional": true,
      "figmaLayer": "focus-ring",
      "figmaToggle": {
        "property": "focusRing",
        "type": "BOOLEAN",
        "default": false
      }
    },
    "icon": {
      "element": "slot",
      "description": "Hueco para el icono inicial. Se oculta si no hay icono.",
      "optional": true,
      "figmaLayer": "Design / blending-mode (primera instancia)",
      "figmaToggle": {
        "property": "iconStart",
        "type": "BOOLEAN",
        "default": false
      },
      "slot": {
        "key": "icon",
        "allowedComponents": [
          "Icon"
        ],
        "minItems": 0,
        "maxItems": 1,
        "mandatory": false,
        "figmaProp": "⮑ 🔄 iconStart"
      }
    },
    "label": {
      "element": "span",
      "description": "Texto de la etiqueta.",
      "figmaLayer": "Button (capa de texto)",
      "content": {
        "prop": "children"
      }
    },
    "iconEnd": {
      "element": "slot",
      "description": "Hueco para el icono final.",
      "optional": true,
      "figmaLayer": "Design / blending-mode (segunda instancia)",
      "figmaToggle": {
        "property": "iconEnd",
        "type": "BOOLEAN",
        "default": false
      },
      "slot": {
        "key": "iconEnd",
        "allowedComponents": [
          "Icon"
        ],
        "minItems": 0,
        "maxItems": 1,
        "mandatory": false,
        "figmaProp": "⮑ 🔄 iconEnd"
      }
    },
    "spinner": {
      "element": "svg",
      "description": "Spinner de 8 hojas. Solo con loading=true; sustituye a icono y etiqueta.",
      "optional": true,
      "figmaLayer": "Spinner"
    }
  },
  "composition": {
    "allowedChildren": null,
    "forbiddenChildren": [
      "Button",
      "a",
      "input"
    ],
    "nestedComponents": [],
    "asChild": false
  },
  "layout": {
    "height": {
      "mode": "fixed",
      "values": {
        "1": 24,
        "2": 32,
        "3": 40,
        "4": 48
      },
      "unit": "px",
      "token": "tokens.space.button-height-{size}"
    },
    "width": {
      "default": "hug",
      "modes": {
        "hug": "El ancho se ajusta al contenido más el padding horizontal. Por defecto.",
        "fill": "Lo decide quien usa el componente con su layout; no hay prop.",
        "fixed": "Valor explícito de quien consume el componente. Sin token del sistema."
      },
      "min": null,
      "max": null,
      "note": "En Figma, loading=true conserva el ancho (verificado en size 2: 70px con y sin loading)."
    },
    "autoLayout": {
      "direction": "HORIZONTAL",
      "sizingHorizontal": "HUG",
      "sizingVertical": "FIXED",
      "alignMain": "CENTER",
      "alignCross": "CENTER",
      "gap": "Por size: spacing.1 / 2 / 3 / 3, entre icono y etiqueta"
    },
    "iconSize": {
      "values": {
        "1": 16,
        "2": 16,
        "3": 18,
        "4": 20
      },
      "unit": "px"
    }
  },
  "tokens": {
    "policy": {
