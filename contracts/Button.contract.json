{
  "$schema": "./component.schema.json",
  "id": "button",
  "name": "Button",
  "version": "0.1.0",
  "status": "draft",
  "category": "action",
  "description": "Triggers an action or navigates to a destination when pressed.",
  "guidance": {
    "dos": [
      "Use a single verb label that describes the action: 'Save', 'Send', 'Delete'.",
      "Use variant=solid for the primary action on a surface; use at most one per area.",
      "Use variant=outline or ghost for secondary and tertiary actions."
    ],
    "donts": [
      {
        "case": "Navigating to an external URL as a styled link",
        "useInstead": "Link",
        "why": "A <button> has no href; screen readers announce it as a button, not a link."
      },
      {
        "case": "Destructive action without confirmation step",
        "useInstead": "Button inside a confirmation Dialog",
        "why": "Accidental irreversible actions are a UX and legal risk."
      }
    ],
    "related": [
      {
        "component": "IconButton",
        "relation": "alternative",
        "difference": "No label — icon only. Use when space is very constrained and the icon is universally understood."
      },
      {
        "component": "Link",
        "relation": "alternative",
        "difference": "Renders an <a> tag with href. Use for navigation, not actions."
      }
    ]
  },
  "semantics": {
    "element": "button",
    "role": null,
    "refTarget": "root",
    "elementByProp": null
  },
  "props": [
    {
      "name": "variant",
      "type": "'solid' | 'outline' | 'ghost'",
      "default": "solid",
      "required": false,
      "description": "Visual style. solid = filled primary background. outline = border, transparent background. ghost = no border, no background.",
      "bindings": {
        "figma": { "property": "Variant", "type": "VARIANT" }
      }
    },
    {
      "name": "size",
      "type": "'sm' | 'md' | 'lg'",
      "default": "md",
      "required": false,
      "description": "Height and padding scale. sm=32px md=40px lg=48px.",
      "bindings": {
        "figma": { "property": "Size", "type": "VARIANT" }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "Prevents interaction. Applies disabled token set, not opacity.",
      "bindings": {
        "figma": { "property": "Disabled", "type": "BOOLEAN" }
      }
    },
    {
      "name": "loading",
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "Shows spinner and hides label. Also disables interaction.",
      "bindings": {
        "figma": { "property": "Loading", "type": "BOOLEAN" }
      }
    },
    {
      "name": "children",
      "type": "ReactNode",
      "default": null,
      "required": true,
      "description": "Button label text.",
      "bindings": {
        "figma": { "property": "Label", "type": "TEXT" }
      }
    },
    {
      "name": "iconStart",
      "type": "ReactNode",
      "default": null,
      "required": false,
      "description": "Icon placed before the label.",
      "bindings": {
        "figma": { "property": "Icon start", "type": "INSTANCE_SWAP" }
      }
    },
    {
      "name": "iconEnd",
      "type": "ReactNode",
      "default": null,
      "required": false,
      "description": "Icon placed after the label.",
      "bindings": {
        "figma": { "property": "Icon end", "type": "INSTANCE_SWAP" }
      }
    },
    {
      "name": "fullWidth",
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "Stretches button to fill its container width.",
      "bindings": {
        "figma": { "property": "Full width", "type": "BOOLEAN" }
      }
    }
  ],
  "states": {
    "native": ["hover", "focus-visible", "active"],
    "controlled": [
      {
        "name": "disabled",
        "description": "Component is non-interactive. Visually dimmed using disabled tokens, not opacity.",
        "aria": "aria-disabled"
      },
      {
        "name": "loading",
        "description": "Action is in progress. Spinner replaces label. Button is non-interactive.",
        "aria": "aria-busy"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "button",
      "description": "Root interactive element.",
      "figmaLayer": "root"
    },
    "iconStart": {
      "element": "span",
      "description": "Optional icon before label.",
      "optional": true,
      "figmaLayer": "icon-start",
      "figmaToggle": { "property": "Icon start", "type": "BOOLEAN", "default": false }
    },
    "label": {
      "element": "span",
      "description": "Button label text.",
      "figmaLayer": "label",
      "content": { "prop": "children" }
    },
    "iconEnd": {
      "element": "span",
      "description": "Optional icon after label.",
      "optional": true,
      "figmaLayer": "icon-end",
      "figmaToggle": { "property": "Icon end", "type": "BOOLEAN", "default": false }
    },
    "spinner": {
      "element": "span",
      "description": "Loading indicator. Visible only when loading=true.",
      "optional": true,
      "figmaLayer": "spinner"
    }
  },
  "composition": {
    "allowedChildren": null,
    "forbiddenChildren": ["Button", "IconButton"],
    "nestedComponents": [],
    "codeParts": [],
    "asChild": false
  },
  "layout": {
    "height": {
      "mode": "fixed",
      "values": { "sm": 32, "md": 40, "lg": 48 },
      "unit": "px",
      "token": "spacing.{size}"
    },
    "width": {
      "default": "hug",
      "modes": {
        "hug": "default — wraps content",
        "fill": "when fullWidth=true"
      },
      "min": null,
      "max": null,
      "note": null
    },
    "autoLayout": {
      "direction": "HORIZONTAL",
      "sizingHorizontal": "HUG",
      "sizingVertical": "FIXED",
      "alignMain": "CENTER",
      "alignCross": "CENTER",
      "gap": "spacing.2 between iconStart, label, iconEnd"
    }
  },
  "tokens": {
    "policy": {
      "allowed": ["color", "spacing", "radius", "font", "shadow"],
      "forbidden": ["primitives"]
    },
    "bindings": {
      "base": {
        "radius": "radius.full",
        "paddingX": "spacing.4",
        "fontSize": "font.size.sm",
        "fontWeight": "font.weight.medium",
        "gap": "spacing.2"
      },
      "byVariant": {
        "solid": {
          "background": "color.primary",
          "text": "color.primary-foreground",
          "border": null
        },
        "outline": {
          "background": "color.background",
          "text": "color.foreground",
          "border": "color.border"
        },
        "ghost": {
          "background": null,
          "text": "color.foreground",
          "border": null
        }
      },
      "byState": {
        "disabled": {
          "background": "color.muted",
          "text": "color.muted-foreground",
          "border": "color.border"
        }
      }
    }
  },
  "events": [
    {
      "name": "onClick",
      "trigger": "Click or Enter/Space keydown on root",
      "payload": "React.MouseEvent | React.KeyboardEvent",
      "blockedWhen": ["disabled", "loading"]
    }
  ],
  "a11y": {
    "role": "button (implicit from <button>)",
    "name": "From children text content, or aria-label if icon-only",
    "keyboard": [
      "Enter — trigger onClick",
      "Space — trigger onClick"
    ],
    "focusIndicator": "2px solid color.ring, offset 2px",
    "minTarget": "40x40px (WCAG 2.5.8)",
    "contrastNote": "color.primary vs color.primary-foreground must meet WCAG AA (4.5:1 for text)",
    "wcag": ["1.4.3 Contrast (AA)", "2.1.1 Keyboard", "2.4.7 Focus Visible", "2.5.8 Target Size"]
  },
  "content": {
    "label": {
      "maxLength": 32,
      "casing": "sentence",
      "voice": "Single verb or short verb phrase. 'Save changes', 'Delete account'."
    }
  },
  "behavior": {
    "loading": "Spinner replaces label area. Width stays fixed to avoid layout shift.",
    "overflow": "truncate",
    "motion": [
      {
        "on": "hover",
        "property": "background-color",
        "reducedMotion": "instant"
      },
      {
        "on": "active",
        "property": "transform: scale(0.97)",
        "reducedMotion": "instant"
      }
    ],
    "responsive": []
  },
  "form": null,
  "overlay": null,
  "data": null,
  "media": null,
  "theming": {
    "modes": ["light", "dark"],
    "density": null
  },
  "i18n": {
    "rtl": "iconStart and iconEnd swap sides automatically with dir=rtl.",
    "textExpansion": "Width grows with label (hug); set maxWidth if layout is constrained."
  },
  "testing": {
    "cases": [
      "Renders label text",
      "onClick fires on click and Enter/Space",
      "onClick does not fire when disabled=true",
      "onClick does not fire when loading=true",
      "Shows spinner when loading=true",
      "fullWidth stretches to 100%",
      "All three variants render without crashing",
      "All three sizes render without crashing"
    ]
  },
  "governance": {
    "owners": ["mokkapp-studio"],
    "changelog": "contracts/Button.contract.json"
  },
  "anchors": {
    "figma": {
      "file": "https://www.figma.com/design/dYAgYb0igDOCarC4bFzfC7/DS-MOKKAPP",
      "node": null
    },
    "code": {
      "importPath": "@/components/ui/Button",
      "export": "Button"
    }
  },
  "meta": {
    "source": "manual",
    "needsReview": [
      "anchors.figma.node — Button not yet created in Figma",
      "layout.height tokens — confirm sm=32/md=40/lg=48 with Figma once built",
      "hover darken amount — 8% filter or use primitives.green.7?"
    ],
    "derivableFromSource": ["props", "anatomy", "layout", "tokens.bindings"]
  }
}
