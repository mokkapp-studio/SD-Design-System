{
  "$schema": "./component.schema.json",
  "id": "card",
  "name": "Card",
  "version": "0.1.0",
  "status": "draft",
  "category": "container",
  "description": "Rounded surface that groups related content with an optional header and footer.",
  "guidance": {
    "dos": [
      "Use Card as a visual grouping container for related content.",
      "Use CardHeader, CardBody, CardFooter sub-components for internal structure."
    ],
    "donts": [
      { "case": "Nesting Card inside Card more than one level deep", "useInstead": "A flat layout", "why": "Nested surfaces fragment visual hierarchy." }
    ],
    "related": [
      { "component": "FeatureCard", "relation": "similar", "difference": "FeatureCard is a fixed-structure card for feature highlights; Card is an open container." },
      { "component": "PricingCard", "relation": "similar", "difference": "PricingCard is a fixed-structure card for pricing tiers." }
    ]
  },
  "semantics": { "element": "div", "role": null, "refTarget": "root", "elementByProp": null },
  "props": [
    {
      "name": "variant",
      "type": "'default' | 'elevated' | 'outlined'",
      "default": "default",
      "required": false,
      "description": "default=border, elevated=shadow only, outlined=2px border.",
      "bindings": { "figma": { "property": "Variant", "type": "VARIANT" } }
    },
    {
      "name": "padding",
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Whether to apply default padding (spacing.6).",
      "bindings": { "figma": { "property": "Padding", "type": "BOOLEAN" } }
    },
    {
      "name": "children",
      "type": "ReactNode",
      "default": null,
      "required": true,
      "description": "Card content. Use CardHeader, CardBody, CardFooter for structure.",
      "bindings": { "figma": { "property": "Content", "type": "SLOT" } }
    }
  ],
  "states": { "native": [], "controlled": [] },
  "anatomy": {
    "root":   { "element": "div", "description": "Card surface.", "figmaLayer": "root" },
    "header": { "element": "div", "description": "Optional header area.", "optional": true, "figmaLayer": "header" },
    "body":   { "element": "div", "description": "Main content area.", "figmaLayer": "body" },
    "footer": { "element": "div", "description": "Optional footer area separated by a top border.", "optional": true, "figmaLayer": "footer" }
  },
  "composition": {
    "allowedChildren": null,
    "forbiddenChildren": [],
    "nestedComponents": [],
    "codeParts": [
      { "name": "Card.Header", "description": "Optional header slot." },
      { "name": "Card.Body",   "description": "Main content slot." },
      { "name": "Card.Footer", "description": "Optional footer slot with a top divider." }
    ],
    "asChild": false
  },
  "layout": {
    "height": { "mode": "hug", "values": {}, "unit": "px", "token": null },
    "width":  { "default": "fill", "modes": { "fill": "100% of parent" }, "min": null, "max": null, "note": null },
    "autoLayout": { "direction": "VERTICAL", "sizingHorizontal": "FILL", "sizingVertical": "HUG", "alignMain": "MIN", "alignCross": "MIN", "gap": "spacing.4 between header/body/footer" }
  },
  "tokens": {
    "policy": { "allowed": ["color", "spacing", "radius", "shadow"], "forbidden": ["primitives"] },
    "bindings": {
      "base": { "background": "color.card", "radius": "radius.lg", "padding": "spacing.6" },
      "byVariant": {
        "default":  { "border": "color.border", "shadow": null },
        "elevated": { "border": null,            "shadow": "shadow.md" },
        "outlined": { "border": "color.border",  "shadow": null }
      }
    }
  },
  "events": [],
  "a11y": {
    "role": "none — semantics come from content",
    "name": "Determined by content",
    "keyboard": [],
    "focusIndicator": "none — non-interactive wrapper",
    "minTarget": "n/a",
    "contrastNote": "Content inside card must meet WCAG AA against color.card",
    "wcag": ["1.4.3 Contrast (AA)"]
  },
  "content": { "label": { "maxLength": 0, "casing": "sentence", "voice": "Open container — no label constraint." } },
  "behavior": { "loading": null, "overflow": "scroll when content overflows", "motion": [], "responsive": [] },
  "form": null, "overlay": null, "data": null, "media": null,
  "theming": { "modes": ["light", "dark"], "density": null },
  "i18n": { "rtl": "auto — layout flips with dir=rtl", "textExpansion": "Card grows vertically with content." },
  "testing": {
    "cases": [
      "default variant shows border, no shadow",
      "elevated variant shows shadow, no border",
      "padding=false removes internal padding",
      "CardHeader/CardBody/CardFooter sub-components render in correct order"
    ]
  },
  "governance": { "owners": ["mokkapp-studio"], "changelog": "contracts/Card.contract.json" },
  "anchors": {
    "figma": { "file": "https://www.figma.com/design/dYAgYb0igDOCarC4bFzfC7/DS-MOKKAPP", "node": null },
    "code": { "importPath": "@/components/ui/Card", "export": "Card" }
  },
  "meta": { "source": "manual", "needsReview": ["anchors.figma.node"], "derivableFromSource": ["props", "anatomy", "layout"] }
}
