{
  "$schema": "./component.schema.json",
  "id": "checkbox",
  "name": "Checkbox",
  "version": "0.1.0",
  "status": "draft",
  "category": "input",
  "description": "Casilla que activa o desactiva una opción independiente, con un tercer estado «indeterminado» para selecciones parciales. Se usa en formularios y listas.",
  "guidance": {
    "dos": [
      "Usa una etiqueta visible (`label`) que describa la opción en positivo: «Recibir novedades».",
      "Usa `indeterminate` solo para un «seleccionar todo» cuando hay hijos marcados y sin marcar.",
      "Agrupa varias casillas relacionadas en CheckboxGroup.",
      "La casilla y su etiqueta son un único objetivo pulsable: pulsar la etiqueta marca la casilla."
    ],
    "donts": [
      {
        "case": "Elegir una sola opción entre varias",
        "useInstead": "RadioGroup",
        "why": "Una casilla permite marcar varias a la vez."
      },
      {
        "case": "Activar algo que surte efecto al instante (ajuste)",
        "useInstead": "Switch",
        "why": "Una casilla se confirma al enviar el formulario; un Switch actúa al cambiar."
      },
      {
        "case": "Lanzar una acción",
        "useInstead": "Button",
        "why": "Una casilla guarda un valor, no ejecuta."
      },
      {
        "case": "Casilla sin etiqueta",
        "useInstead": "Checkbox con label o aria-label",
        "why": "Sin nombre accesible no se sabe qué se marca."
      }
    ],
    "related": [
      {
        "component": "CheckboxGroup",
        "relation": "contained-by",
        "difference": "Agrupa de 1 a 6 casillas en vertical con un gap de spacing.3."
      },
      {
        "component": "RadioGroup",
        "relation": "alternative",
        "difference": "Solo una opción."
      },
      {
        "component": "Switch",
        "relation": "alternative",
        "difference": "Efecto inmediato."
      }
    ]
  },
  "semantics": {
    "element": "button",
    "role": "checkbox",
    "refTarget": "box",
    "elementByProp": null
  },
  "props": [
    {
      "name": "variant",
      "type": "'classic' | 'surface' | 'soft'",
      "default": "surface",
      "description": "Aspecto. surface = fondo claro con borde; classic = igual con sombra; soft = relleno tenue de acento sin borde.",
      "bindings": {
        "figma": {
          "property": "variant",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "size",
      "type": "'1' | '2' | '3'",
      "default": "2",
      "description": "Tamaño de la casilla: 14 / 16 / 20 px, con su texto y espaciado. El 2 es el valor por defecto.",
      "bindings": {
        "figma": {
          "property": "size",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "highContrast",
      "type": "boolean",
      "default": false,
      "description": "Si es true y la casilla está marcada, usa el paso 12 del acento. Sin marcar no cambia.",
      "bindings": {
        "figma": {
          "property": "highContrast",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "checked",
      "type": "boolean | 'indeterminate'",
      "default": false,
      "description": "Valor. En Figma es el eje `status`: false = «unchecked ✦», true = «checked ✓», 'indeterminate' = «indeterminate».",
      "bindings": {
        "figma": {
          "property": "status",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "Si es true, no se puede marcar ni enfocar. En Figma es el valor «disable» del eje `state`.",
      "bindings": {
        "figma": {
          "property": "state",
          "type": "VARIANT",
          "value": "disable"
        }
      }
    },
    {
      "name": "label",
      "type": "string | undefined",
      "default": null,
      "description": "Texto junto a la casilla. En Figma el boolean `text` lo muestra u oculta (oculto por defecto). Texto de ejemplo: «Text».",
      "bindings": {
        "figma": {
          "property": "⮑ ✏️ text",
          "type": "TEXT"
        }
      }
    },
    {
      "name": "name",
      "type": "string | undefined",
      "default": null,
      "description": "Nombre del campo al enviar un formulario. Solo de código.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "onCheckedChange",
      "type": "(checked: boolean | 'indeterminate') => void",
      "default": null,
      "description": "Se emite al cambiar el valor. Solo de código.",
      "bindings": {
        "figma": null
      }
    }
  ],
  "states": {
    "native": [
      "hover",
      "focus-visible",
      "active"
    ],
    "controlled": [
      {
        "name": "checked",
        "description": "Casilla marcada. Muestra el check.",
        "aria": "aria-checked='true'"
      },
      {
        "name": "indeterminate",
        "description": "Selección parcial. Muestra un guion.",
        "aria": "aria-checked='mixed'"
      },
      {
        "name": "disabled",
        "description": "No interactiva. Fondo y borde con tokens neutros; nunca con opacity.",
        "aria": "disabled (atributo HTML nativo)"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "span",
      "description": "Contenedor de casilla y etiqueta. Un solo objetivo pulsable.",
      "figmaLayer": "Checkbox (cada variante del component set)"
    },
    "focusRing": {
      "element": "css",
      "description": "No es un elemento: se pinta con :focus-visible. En Figma es una capa que se muestra con el boolean focusRing: borde exterior de 4px e interior de 2px.",
      "optional": true,
      "figmaLayer": "focus-ring",
      "figmaToggle": {
        "property": "focusRing",
        "type": "BOOLEAN",
        "default": false
      }
    },
    "box": {
      "element": "button",
      "description": "La casilla. Lleva role=checkbox y aria-checked.",
      "figmaLayer": "checkbox"
    },
    "indicator": {
      "element": "svg",
      "description": "Check (marcada) o guion (indeterminado). Oculto si no está marcada.",
      "optional": true,
      "figmaLayer": "Abstract / check | Typography / dash"
    },
    "label": {
      "element": "label",
      "description": "Texto junto a la casilla. Asociado a la casilla.",
      "optional": true,
      "figmaLayer": "Text",
      "figmaToggle": {
        "property": "text",
        "type": "BOOLEAN",
        "default": false
      },
      "content": {
        "prop": "label"
      }
    }
  },
