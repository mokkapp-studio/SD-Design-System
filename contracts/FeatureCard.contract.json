{
  "$schema": "./component.schema.json",
  "id": "feature-card",
  "name": "FeatureCard",
  "version": "0.1.0",
  "status": "draft",
  "category": "container",
  "description": "Fixed-structure card for a single feature: icon, title, and description.",
  "guidance": {
    "dos": [
      "Use in a grid of 3–4 feature cards on marketing pages.",
      "Keep description under 120 characters for consistent card heights."
    ],
    "donts": [
      { "case": "Using FeatureCard for user-generated content", "useInstead": "Card with custom children", "why": "FeatureCard has a fixed icon+title+description layout." }
    ],
    "related": [
      { "component": "Card", "relation": "similar", "difference": "Card is an open container; FeatureCard has a fixed icon/title/description structure." }
    ]
  },
  "semantics": { "element": "div", "role": null, "refTarget": "root", "elementByProp": null },
  "props": [
    {
      "name": "icon",
      "type": "ReactNode",
      "default": null,
      "required": false,
      "description": "Icon rendered in a square container above the title.",
      "bindings": { "figma": { "property": "Icon", "type": "INSTANCE_SWAP" } }
    },
    {
      "name": "title",
      "type": "string",
      "default": null,
      "required": true,
      "description": "Feature heading. Keep under 40 chars.",
      "bindings": { "figma": { "property": "Title", "type": "TEXT" } }
    },
    {
      "name": "description",
      "type": "string",
      "default": null,
      "required": true,
      "description": "One or two sentence description of the feature.",
      "bindings": { "figma": { "property": "Description", "type": "TEXT" } }
    },
    {
      "name": "variant",
      "type": "'default' | 'accent'",
      "default": "default",
      "required": false,
      "description": "accent adds a primary-colored border and filled icon background.",
      "bindings": { "figma": { "property": "Variant", "type": "VARIANT" } }
    }
  ],
  "states": { "native": ["hover"], "controlled": [] },
  "anatomy": {
    "root":        { "element": "div", "description": "Card surface.", "figmaLayer": "root" },
    "icon":        { "element": "div", "description": "Icon container.", "optional": true, "figmaLayer": "icon", "content": { "prop": "icon" } },
    "title":       { "element": "h3",  "description": "Feature title.", "figmaLayer": "title", "content": { "prop": "title" } },
    "description": { "element": "p",   "description": "Feature description.", "figmaLayer": "description", "content": { "prop": "description" } }
  },
  "composition": { "allowedChildren": null, "forbiddenChildren": [], "nestedComponents": [], "codeParts": [], "asChild": false },
  "layout": {
    "height": { "mode": "hug", "values": {}, "unit": "px", "token": null },
    "width":  { "default": "fill", "modes": { "fill": "fills grid cell" }, "min": "240px", "max": null, "note": null },
    "autoLayout": { "direction": "VERTICAL", "sizingHorizontal": "FILL", "sizingVertical": "HUG", "alignMain": "MIN", "alignCross": "MIN", "gap": "spacing.3 between parts" }
  },
  "tokens": {
    "policy": { "allowed": ["color", "spacing", "radius", "font"], "forbidden": ["primitives"] },
    "bindings": {
      "base": {
        "background":    "color.card",
        "radius":        "radius.lg",
        "padding":       "spacing.6",
        "border":        "color.border",
        "titleSize":     "font.size.lg",
        "titleWeight":   "font.weight.semibold",
        "descSize":      "font.size.sm",
        "descColor":     "color.muted-foreground",
        "iconSize":      "spacing.12",
        "iconRadius":    "radius.md"
      },
      "byVariant": {
        "default": { "iconBackground": "color.muted",    "iconColor": "color.primary",            "border": "color.border" },
        "accent":  { "iconBackground": "color.primary",  "iconColor": "color.primary-foreground",  "border": "color.primary" }
      }
    }
  },
  "events": [],
  "a11y": {
    "role": "none — semantics from h3 heading",
    "name": "Title text",
    "keyboard": [],
    "focusIndicator": "none — non-interactive",
    "minTarget": "n/a",
    "contrastNote": "Description text (color.muted-foreground on color.card) must meet WCAG AA",
    "wcag": ["1.4.3 Contrast (AA)"]
  },
  "content": {
    "label": { "maxLength": 40, "casing": "sentence", "voice": "Noun phrase. 'Real-time sync', 'Zero config setup'." }
  },
  "behavior": { "loading": null, "overflow": "description wraps", "motion": [], "responsive": [] },
  "form": null, "overlay": null, "data": null, "media": null,
  "theming": { "modes": ["light", "dark"], "density": null },
  "i18n": { "rtl": "icon moves to right, text aligns right", "textExpansion": "Card grows vertically; keep grids aligned with min-height." },
  "testing": {
    "cases": [
      "Renders icon, title, description in correct order",
      "default variant: muted icon bg, primary icon color, border",
      "accent variant: primary icon bg, primary-foreground icon color, primary border",
      "Card height matches sibling cards when description length varies"
    ]
  },
  "governance": { "owners": ["mokkapp-studio"], "changelog": "contracts/FeatureCard.contract.json" },
  "anchors": {
    "figma": { "file": "https://www.figma.com/design/dYAgYb0igDOCarC4bFzfC7/DS-MOKKAPP", "node": null },
    "code": { "importPath": "@/components/ui/FeatureCard", "export": "FeatureCard" }
  },
  "meta": { "source": "manual", "needsReview": ["anchors.figma.node"], "derivableFromSource": ["props", "anatomy", "layout"] }
}
