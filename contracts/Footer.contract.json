{
  "$schema": "./component.schema.json",
  "id": "footer",
  "name": "Footer",
  "version": "0.1.0",
  "status": "draft",
  "category": "navigation",
  "description": "Site-level footer with logo, link columns, social icons, and a copyright bottom bar.",
  "guidance": {
    "dos": [
      "Place one Footer per page at the bottom of the layout.",
      "Keep column headings to 1–2 words."
    ],
    "donts": [
      { "case": "Using Footer as an in-page section separator", "useInstead": "A divider or section component", "why": "Footer communicates site-level closure; reusing it mid-page confuses navigation landmarks." }
    ],
    "related": [
      { "component": "NavBar", "relation": "similar", "difference": "NavBar is at the top of the viewport; Footer is at the bottom and contains deeper link hierarchies." }
    ]
  },
  "semantics": { "element": "footer", "role": "contentinfo", "refTarget": "root", "elementByProp": null },
  "props": [
    {
      "name": "logo",
      "type": "ReactNode",
      "default": null,
      "required": true,
      "description": "Brand logo or wordmark rendered on the left of the brand column.",
      "bindings": { "figma": { "property": "Logo", "type": "INSTANCE_SWAP" } }
    },
    {
      "name": "columns",
      "type": "{ heading: string; links: { label: string; href: string }[] }[]",
      "default": "[]",
      "required": false,
      "description": "Link column groups rendered after the brand column.",
      "bindings": { "figma": { "property": "Columns", "type": "SLOT" } }
    },
    {
      "name": "bottomText",
      "type": "string",
      "default": null,
      "required": false,
      "description": "Copyright or legal text in the bottom bar.",
      "bindings": { "figma": { "property": "BottomText", "type": "TEXT" } }
    },
    {
      "name": "socials",
      "type": "ReactNode",
      "default": null,
      "required": false,
      "description": "Social media icon links rendered below the logo.",
      "bindings": { "figma": { "property": "Socials", "type": "SLOT" } }
    }
  ],
  "states": { "native": ["hover on links", "focus-visible on links"], "controlled": [] },
  "anatomy": {
    "root":    { "element": "footer", "description": "Full-width footer container.", "figmaLayer": "root" },
    "inner":   { "element": "div",    "description": "Max-width wrapper centered horizontally.", "figmaLayer": "inner" },
    "brand":   { "element": "div",    "description": "Logo and social icons.", "figmaLayer": "brand", "content": { "prop": "logo" } },
    "columns": { "element": "nav",    "description": "Footer link column grid.", "optional": true, "figmaLayer": "columns",
      "slot": { "key": "columns", "allowedComponents": ["FooterColumn"], "minItems": 0, "maxItems": 6, "mandatory": false, "figmaProp": "Columns" }
    },
    "bottom":  { "element": "div",    "description": "Bottom bar with copyright text.", "optional": true, "figmaLayer": "bottom" }
  },
  "composition": {
    "allowedChildren": null,
    "forbiddenChildren": ["NavBar", "Footer"],
    "nestedComponents": [],
    "codeParts": [],
    "asChild": false
  },
  "layout": {
    "height": { "mode": "hug", "values": {}, "unit": "px", "token": null },
    "width":  { "default": "fill", "modes": { "fill": "100vw" }, "min": null, "max": null, "note": "Inner container max-width: 1200px, centered." },
    "autoLayout": { "direction": "VERTICAL", "sizingHorizontal": "FILL", "sizingVertical": "HUG", "alignMain": "MIN", "alignCross": "MIN", "gap": "spacing.8 between inner and bottom" }
  },
  "tokens": {
    "policy": { "allowed": ["color", "spacing", "font"], "forbidden": ["primitives"] },
    "bindings": {
      "base": {
        "background":    "color.card",
        "borderTop":     "color.border",
        "linkColor":     "color.muted-foreground",
        "linkHover":     "color.foreground",
        "headingColor":  "color.foreground",
        "headingWeight": "font.weight.semibold",
        "headingSize":   "font.size.sm",
        "linkSize":      "font.size.sm",
        "padding":       "spacing.16"
      }
    }
  },
  "events": [],
  "a11y": {
    "role": "contentinfo (implicit from footer)",
    "name": "Site footer",
    "keyboard": ["Tab — move through links"],
    "focusIndicator": "2px solid color.ring, offset 2px on links",
    "minTarget": "Links min 24px height (WCAG 2.5.8)",
    "contrastNote": "Link text (color.muted-foreground) on background must meet WCAG AA",
    "wcag": ["1.4.3 Contrast (AA)", "2.1.1 Keyboard", "2.4.7 Focus Visible", "4.1.2 Name Role Value"]
  },
  "content": { "label": { "maxLength": 15, "casing": "title", "voice": "Short noun. 'Product', 'Company', 'Legal'." } },
  "behavior": { "loading": null, "overflow": "columns wrap on mobile to a 2-column grid", "motion": [], "responsive": ["< 768px: single column layout"] },
  "form": null, "overlay": null, "data": null, "media": null,
  "theming": { "modes": ["light", "dark"], "density": null },
  "i18n": { "rtl": "logo to right, columns reverse order", "textExpansion": "Link text grows; columns wrap earlier." },
  "testing": {
    "cases": [
      "Renders logo, all columns, bottom text",
      "bottomText absent: bottom bar not rendered",
      "socials absent: social row not rendered",
      "Link hover changes color to color.foreground",
      "All links keyboard-accessible"
    ]
  },
  "governance": { "owners": ["mokkapp-studio"], "changelog": "contracts/Footer.contract.json" },
  "anchors": {
    "figma": { "file": "https://www.figma.com/design/dYAgYb0igDOCarC4bFzfC7/DS-MOKKAPP", "node": null },
    "code": { "importPath": "@/components/ui/Footer", "export": "Footer" }
  },
  "meta": { "source": "manual", "needsReview": ["anchors.figma.node"], "derivableFromSource": ["props", "anatomy", "layout"] }
}
