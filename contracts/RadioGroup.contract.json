{
  "$schema": "./component.schema.json",
  "id": "radio-group",
  "name": "RadioGroup",
  "version": "0.1.0",
  "status": "draft",
  "category": "input",
  "description": "Conjunto de opciones excluyentes: solo una puede estar seleccionada a la vez. Cada opción es un Radio con su etiqueta.",
  "guidance": {
    "dos": [
      "Usa de 2 a 6 opciones visibles a la vez y muestra todas las opciones de un vistazo.",
      "Da nombre accesible al grupo (aria-label o aria-labelledby): Figma no define una etiqueta de grupo.",
      "Etiquetas cortas y paralelas, en positivo.",
      "Preselecciona la opción más segura o habitual cuando tenga sentido.",
      "Mantén las opciones en una sola columna; el orden refleja la prioridad o la lógica natural."
    ],
    "donts": [
      {
        "case": "Varias opciones a la vez",
        "useInstead": "Checkbox / CheckboxGroup",
        "why": "Un radio solo permite una selección."
      },
      {
        "case": "Más de 6 opciones o lista larga",
        "useInstead": "Select",
        "why": "Ocupa demasiado y dificulta comparar."
      },
      {
        "case": "Activar un ajuste al instante",
        "useInstead": "Switch",
        "why": "Un grupo de radios se confirma con el formulario."
      },
      {
        "case": "Grupo sin ninguna opción disponible o con una sola",
        "useInstead": "Checkbox o texto",
        "why": "Una única opción no es una elección."
      }
    ],
    "related": [
      {
        "component": "Checkbox",
        "relation": "alternative",
        "difference": "Permite varias selecciones y estado indeterminado."
      },
      {
        "component": "Select",
        "relation": "alternative",
        "difference": "Mejor con muchas opciones."
      },
      {
        "component": "Switch",
        "relation": "alternative",
        "difference": "Efecto inmediato."
      }
    ]
  },
  "semantics": {
    "element": "div",
    "role": "radiogroup",
    "refTarget": "root",
    "elementByProp": null
  },
  "props": [
    {
      "name": "variant",
      "type": "'classic' | 'surface' | 'soft'",
      "default": "surface",
      "description": "Aspecto de todos los radios. surface = fondo claro con borde; classic = igual con sombra; soft = relleno tenue de acento sin borde.",
      "bindings": {
        "figma": {
          "property": "variant",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "size",
      "type": "'1' | '2' | '3'",
      "default": "2",
      "description": "Tamaño del radio: 14 / 16 / 20 px, con su texto y el espacio entre opciones. El 2 es el valor por defecto.",
      "bindings": {
        "figma": {
          "property": "size",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "highContrast",
      "type": "boolean",
      "default": false,
      "description": "Si es true, la opción seleccionada usa el paso 12 del acento. Sin seleccionar no cambia.",
      "bindings": {
        "figma": {
          "property": "highContrast",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "children",
      "type": "ReactNode (RadioGroup.Item)",
      "required": true,
      "description": "Las opciones. En Figma, hasta 6 con los booleanos item #1…#6; por defecto se ven 3.",
      "bindings": {
        "figma": {
          "property": "item #1…#6",
          "type": "BOOLEAN"
        }
      }
    },
    {
      "name": "value",
      "type": "string | undefined",
      "default": null,
      "description": "Valor de la opción seleccionada. En Figma, la selección es el eje `status=checked` de un Radio concreto (override de instancia), no una propiedad del grupo.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "Si es true, deshabilita todo el grupo. En Figma solo existe por opción (`state=disable` del Radio); el grupo no la tiene.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "name",
      "type": "string | undefined",
      "default": null,
      "description": "Nombre del campo al enviar un formulario. Solo de código.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "onValueChange",
      "type": "(value: string) => void",
      "default": null,
      "description": "Se emite al cambiar la selección. Solo de código.",
      "bindings": {
        "figma": null
      }
    }
  ],
  "states": {
    "native": [
      "hover",
      "focus-visible",
      "active"
    ],
    "controlled": [
      {
        "name": "checked",
        "description": "La opción seleccionada. Muestra el indicador (punto).",
        "aria": "aria-checked='true' en el item; el resto false"
      },
      {
        "name": "disabled",
        "description": "No interactiva. Fondo y borde con tokens neutros; nunca con opacity.",
        "aria": "disabled en el item (o en todos)"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "div",
      "description": "Contenedor vertical de las opciones. Lleva role=radiogroup.",
      "figmaLayer": "item-container"
    },
    "item": {
      "element": "slot",
      "description": "Hueco para cada opción (RadioGroup.Item).",
      "figmaLayer": "Radio",
      "slot": {
        "key": "item",
        "allowedComponents": [
          "RadioGroup.Item"
        ],
        "minItems": 2,
        "maxItems": 6,
        "mandatory": true,
        "figmaProp": "item #1…#6"
      }
    },
    "focusRing": {
      "element": "css",
      "description": "No es un elemento: se pinta con :focus-visible sobre el radio. En Figma es el boolean focusRing de cada Radio: borde exterior de 4px e interior de 2px.",
      "optional": true,
      "figmaLayer": "focus-ring",
      "figmaToggle": {
        "property": "focusRing",
        "type": "BOOLEAN",
        "default": false
      }
    },
    "radio": {
      "element": "button",
      "description": "El círculo de cada opción. Lleva role=radio y aria-checked.",
      "figmaLayer": "radio"
    },
    "indicator": {
      "element": "span",
      "description": "Punto central de la opción seleccionada. Oculto si no está seleccionada.",
      "optional": true,
      "figmaLayer": "indicator"
    },
    "itemLabel": {
      "element": "label",
      "description": "Texto de cada opción. Asociado al radio.",
      "optional": true,
      "figmaLayer": "Text",
      "figmaToggle": {
        "property": "text",
        "type": "BOOLEAN",
        "default": false
      }
    }
  },
  "composition": {
    "allowedChildren": [
      "RadioGroup.Item"
    ],
    "forbiddenChildren": [
      "RadioGroup",
      "Button"
    ],
    "nestedComponents": [],
    "codeParts": [
      {
        "name": "RadioGroup.Root",
        "description": "El grupo (este componente)."
      },
      {
        "name": "RadioGroup.Item",
        "description": "Una opción: props value (string, obligatoria), disabled y label (children)."
      }
    ],
    "asChild": false,
    "item": {
      "figmaComponent": "Radio (851:29635), 144 variantes, componente propio de Figma",
      "props": [
        {
          "name": "value",
          "type": "string",
          "required": true,
          "figma": null
        },
        {
          "name": "label",
          "type": "string | undefined",
          "figma": {
            "property": "⮑ ✏️ text",
            "type": "TEXT",
            "toggle": "text"
          }
        },
        {
          "name": "disabled",
          "type": "boolean",
          "figma": {
            "property": "state",
            "type": "VARIANT",
            "value": "disable"
          }
        },
        {
          "name": "checked (derivado de value)",
          "type": "boolean",
          "figma": {
            "property": "status",
            "type": "VARIANT",
            "value": "checked ✓"
          }
        }
      ]
    }
  },
  "layout": {
    "height": {
      "mode": "hug",
      "values": {
        "1": 56,
        "2": 76,
