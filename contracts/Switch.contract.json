{
  "$schema": "./component.schema.json",
  "id": "switch",
  "name": "Switch",
  "version": "0.1.0",
  "status": "draft",
  "category": "input",
  "description": "Interruptor de dos posiciones (encendido / apagado) cuyo efecto se aplica al cambiar. Alternativa a la casilla para ajustes.",
  "guidance": {
    "dos": [
      "Usa un Switch para ajustes con efecto inmediato: «Notificaciones», «Modo oscuro».",
      "Etiqueta (`label`) en positivo y que describa el estado «encendido»: «Recibir avisos».",
      "Pon la etiqueta a la derecha del interruptor.",
      "Haz que el cambio se aplique al instante, sin botón de guardar."
    ],
    "donts": [
      {
        "case": "Opción que se confirma al enviar un formulario",
        "useInstead": "Checkbox",
        "why": "Un Switch promete efecto inmediato; una casilla espera al envío."
      },
      {
        "case": "Elegir una opción entre varias",
        "useInstead": "RadioGroup",
        "why": "Un Switch solo tiene dos posiciones."
      },
      {
        "case": "Seleccionar varios elementos de una lista",
        "useInstead": "Checkbox",
        "why": "Un Switch no admite estado indeterminado."
      },
      {
        "case": "Lanzar una acción",
        "useInstead": "Button",
        "why": "Un Switch guarda un estado, no ejecuta."
      }
    ],
    "related": [
      {
        "component": "Checkbox",
        "relation": "alternative",
        "difference": "Se confirma con el formulario; admite indeterminado."
      },
      {
        "component": "RadioGroup",
        "relation": "alternative",
        "difference": "Una opción entre varias."
      },
      {
        "component": "Button",
        "relation": "alternative",
        "difference": "Ejecuta una acción."
      }
    ]
  },
  "semantics": {
    "element": "button",
    "role": "switch",
    "refTarget": "track",
    "elementByProp": null
  },
  "props": [
    {
      "name": "variant",
      "type": "'classic' | 'surface' | 'soft'",
      "default": "surface",
      "description": "Aspecto. surface = pista con borde; classic = igual con sombra interior; soft = relleno tenue de acento sin borde.",
      "bindings": {
        "figma": {
          "property": "variant",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "size",
      "type": "'1' | '2' | '3'",
      "default": "2",
      "description": "Tamaño de la pista: 28x16 / 35x20 / 42x24 px, con su pulgar y espaciado. El 2 es el valor por defecto.",
      "bindings": {
        "figma": {
          "property": "size",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "highContrast",
      "type": "boolean",
      "default": false,
      "description": "Si es true y el interruptor está encendido, usa el paso 12 del acento. Apagado no cambia mucho.",
      "bindings": {
        "figma": {
          "property": "highContrast",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "checked",
      "type": "boolean",
      "default": false,
      "description": "Encendido. En Figma es el eje `status`: false = «unchecked ✦», true = «checked».",
      "bindings": {
        "figma": {
          "property": "status",
          "type": "VARIANT",
          "value": "checked"
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "Si es true, no se puede cambiar. En Figma es el valor «disable» del eje `state`.",
      "bindings": {
        "figma": {
          "property": "state",
          "type": "VARIANT",
          "value": "disable"
        }
      }
    },
    {
      "name": "label",
      "type": "string | undefined",
      "default": null,
      "description": "Texto a la derecha del interruptor. En Figma el boolean `text` lo muestra u oculta (oculto por defecto). Texto de ejemplo: «Text».",
      "bindings": {
        "figma": {
          "property": "⮑ ✏️ text",
          "type": "TEXT"
        }
      }
    },
    {
      "name": "name",
      "type": "string | undefined",
      "default": null,
      "description": "Nombre del campo al enviar un formulario. Solo de código.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "onCheckedChange",
      "type": "(checked: boolean) => void",
      "default": null,
      "description": "Se emite al cambiar de posición. Solo de código.",
      "bindings": {
        "figma": null
      }
    }
  ],
  "states": {
    "native": [
      "hover",
      "focus-visible",
      "active"
    ],
    "controlled": [
      {
        "name": "checked",
        "description": "Encendido. El pulgar va a la derecha y la pista usa el acento.",
        "aria": "aria-checked='true'"
      },
      {
        "name": "disabled",
        "description": "No interactivo. Pista y pulgar con tokens neutros; nunca con opacity.",
        "aria": "disabled (atributo HTML nativo)"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "span",
      "description": "Contenedor de interruptor y etiqueta. Un solo objetivo pulsable.",
      "figmaLayer": "Switch (cada variante del component set)"
    },
    "focusRing": {
      "element": "css",
      "description": "No es un elemento: se pinta con :focus-visible. En Figma es una capa que se muestra con el boolean focusRing: borde exterior de 4px e interior de 2px.",
      "optional": true,
      "figmaLayer": "focus-ring",
      "figmaToggle": {
        "property": "focusRing",
        "type": "BOOLEAN",
        "default": false
      }
    },
    "track": {
      "element": "button",
      "description": "La pista. Lleva role=switch y aria-checked.",
      "figmaLayer": "switch"
    },
    "thumb": {
      "element": "span",
      "description": "El pulgar circular. Izquierda si está apagado, derecha si está encendido.",
      "figmaLayer": "thumb"
    },
    "label": {
      "element": "label",
      "description": "Texto a la derecha. Asociado al interruptor.",
      "optional": true,
      "figmaLayer": "Text",
      "figmaToggle": {
        "property": "text",
        "type": "BOOLEAN",
        "default": false
      },
      "content": {
        "prop": "label"
      }
    }
  },
