{
  "$description": "Iconos permitidos en el sistema. Fuente de verdad: si un icono no está aquí, no se usa. Librería: Iconoir (iconoir-react). Para añadir uno: nueva entrada, `npm run icons:build` (en el proyecto Next.js, `npm run ds:icons`) y `npm run check`.",
  "library": "iconoir-react",
  "install": "npm install iconoir-react",
  "docs": "https://iconoir.com/",
  "defaults": { "size": 16, "strokeWidth": 1.5 },
  "icons": [
    { "name": "ArrowRight", "use": "avanzar, siguiente, continuar" },
    { "name": "Bell", "use": "notificaciones" },
    { "name": "Check", "use": "confirmación, marcado" },
    { "name": "EyeClosed", "use": "ocultar contenido (p. ej. contraseña)" },
    { "name": "EyeSolid", "use": "mostrar contenido (p. ej. contraseña)" },
    { "name": "HomeAlt", "use": "inicio, página principal" },
    { "name": "InfoCircle", "use": "información neutra" },
    { "name": "LogIn", "use": "iniciar sesión" },
    { "name": "LogOut", "use": "cerrar sesión" },
    { "name": "Lock", "use": "campo de contraseña, bloqueo" },
    { "name": "Mail", "use": "campo de email, correo" },
    { "name": "Menu", "use": "abrir menú de navegación (móvil)" },
    { "name": "Minus", "use": "quitar, restar, estado indeterminado" },
    { "name": "NavArrowDown", "use": "desplegar, selector" },
    { "name": "NavArrowRight", "use": "navegar hacia adelante, breadcrumb" },
    { "name": "Plus", "use": "añadir, crear" },
    { "name": "Search", "use": "buscar" },
    { "name": "Settings", "use": "ajustes, configuración" },
    { "name": "Trash", "use": "eliminar (acción destructiva)" },
    { "name": "User", "use": "perfil, cuenta" },
    { "name": "Xmark", "use": "cerrar, borrar el contenido" }
  ]
}
