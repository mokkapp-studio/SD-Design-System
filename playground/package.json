    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "storybook": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
