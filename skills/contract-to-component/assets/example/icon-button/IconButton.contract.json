{
  "$schema": "./component.schema.json",
  "id": "icon-button",
  "name": "IconButton",
  "version": "0.1.0",
  "status": "draft",
  "category": "action",
  "description": "Botón cuadrado que solo muestra un icono y lanza una acción. Mismas variantes, colores y tamaños que Button, pero sin etiqueta: el nombre accesible va en `aria-label`, que es obligatorio.",
  "guidance": {
    "dos": [
      "Da siempre `aria-label` con la acción («Borrar búsqueda», «Cerrar diálogo»).",
      "Usa iconos del registro (`icons/registry.json`) y que el significado sea universal: X, Trash2, Plus, Search.",
      "Dentro de un campo (TextField) usa `variant=\"ghost\"` y `color=\"neutral\"`.",
      "Para acciones poco obvias, añade un Tooltip: un icono solo no siempre se entiende.",
      "Para que dos IconButton parezcan una barra, usa el mismo `variant` y `size` en todos."
    ],
    "donts": [
      {
        "case": "Acción con texto visible",
        "useInstead": "Button (con `icon` si hace falta)",
        "why": "Con texto el botón se entiende sin tooltip y es más fácil de pulsar."
      },
      {
        "case": "IconButton sin aria-label",
        "useInstead": "Siempre aria-label",
        "why": "Sin nombre accesible el lector de pantalla solo dice «botón»."
      },
      {
        "case": "Icono decorativo que no hace nada",
        "useInstead": "Icon",
        "why": "Un botón sin acción engaña a quien navega con teclado."
      },
      {
        "case": "Estado que persiste (activado / desactivado)",
        "useInstead": "Toggle o Checkbox",
        "why": "Un botón ejecuta, no mantiene estado."
      },
      {
        "case": "Acción destructiva sin confirmación",
        "useInstead": "color='error' + AlertDialog",
        "why": "Un icono pequeño se pulsa por error con más facilidad."
      }
    ],
    "related": [
      {
        "component": "Button",
        "relation": "alternative",
        "difference": "Lleva etiqueta de texto; IconButton solo icono."
      },
      {
        "component": "Icon",
        "relation": "contains",
        "difference": "Recibe el icono en el slot `icon`; el tamaño lo fija el size del botón."
      },
      {
        "component": "TextField",
        "relation": "contained-by",
        "difference": "Lo usa como botón final del campo (borrar, mostrar contraseña)."
      }
    ]
  },
  "semantics": {
    "element": "button",
    "role": null,
    "refTarget": "root",
    "elementByProp": null
  },
  "props": [
    {
      "name": "variant",
      "type": "'classic' | 'solid' | 'soft' | 'surface' | 'outline' | 'ghost'",
      "default": "solid",
      "description": "Énfasis visual. solid = relleno pleno; classic = relleno con degradado y borde; soft = relleno tenue; surface = borde con fondo suave; outline = solo borde; ghost = sin relleno ni borde hasta hover.",
      "bindings": {
        "figma": {
          "property": "variant",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "color",
      "type": "'accent' | 'neutral' | 'error'",
      "default": "accent",
      "description": "Significado cromático. accent = color de marca; neutral = gris; error = acción destructiva.",
      "bindings": {
        "figma": {
          "property": "color",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "size",
      "type": "'1' | '2' | '3' | '4'",
      "default": "2",
      "description": "Tamaño físico del cuadrado: 24 / 32 / 40 / 48 px, con icono de 16 / 16 / 18 / 20 px y radio por tamaño. El 2 es el valor por defecto. Mismo size que Button: un IconButton size 2 mide lo mismo que un Button size 2 de alto.",
      "bindings": {
        "figma": {
          "property": "size",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "highContrast",
      "type": "boolean",
      "default": false,
      "description": "Si es true, refuerza el contraste: usa el paso 12 de la escala en lugar del 9/11.",
      "bindings": {
        "figma": {
          "property": "highContrast",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "loading",
      "type": "boolean",
      "default": false,
      "description": "Si es true, la acción está en curso: un spinner sustituye al icono, el tamaño no cambia y no se puede pulsar.",
      "bindings": {
        "figma": {
          "property": "loading",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "Si es true, el botón no es interactivo. En Figma es el valor «disable» del eje `state`.",
      "bindings": {
        "figma": {
          "property": "state",
          "type": "VARIANT",
          "value": "disable"
        }
      }
    },
    {
      "name": "icon",
      "type": "ReactNode",
      "required": true,
      "description": "El icono. Único contenido visible del botón. Tamaño por size: 16 / 16 / 18 / 20 px. Decorativo: lo nombra aria-label del botón, no el icono.",
      "usage": "icon={<Plus />}",
      "bindings": {
        "figma": {
          "property": "⮑ 🔄 icon",
          "type": "INSTANCE_SWAP"
        }
      }
    },
    {
      "name": "aria-label",
      "type": "string",
      "required": true,
      "description": "Nombre accesible. Obligatorio: el botón no tiene texto visible. Describe la acción («Borrar», «Cerrar»), no el icono («X»).",
      "usage": "aria-label=\"Cerrar\"",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "type",
      "type": "'button' | 'submit' | 'reset'",
      "default": "button",
      "description": "Tipo nativo del botón. Solo de código. Usa 'submit' de forma explícita para enviar formularios.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "onPress",
      "type": "(event: MouseEvent<HTMLButtonElement>) => void",
      "default": null,
      "description": "Manejador de pulsación (ratón, teclado o toque). Solo de código.",
      "bindings": {
        "figma": null
      }
    }
  ],
  "states": {
    "native": [
      "hover",
      "focus-visible",
      "active"
    ],
    "controlled": [
      {
        "name": "loading",
        "description": "La acción lanzada está en curso. No es interactivo y muestra un spinner en lugar del icono.",
        "aria": "aria-busy='true'"
      },
      {
        "name": "disabled",
        "description": "No es interactivo. La opción existe pero ahora no está disponible. Se pinta con tokens neutros (neutral-alpha), nunca con opacity.",
        "aria": "disabled (atributo HTML nativo)"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "button",
      "description": "Elemento interactivo raíz. Siempre un <button> nativo, cuadrado.",
      "figmaLayer": "Icon Button (cada variante del component set)"
    },
    "focusRing": {
      "element": "css",
      "description": "No es un elemento: se pinta con :focus-visible. En Figma es una capa que se muestra con el boolean focusRing: borde exterior de 4px e interior de 2px.",
      "optional": true,
      "figmaLayer": "focus-ring",
      "figmaToggle": {
        "property": "focusRing",
        "type": "BOOLEAN",
        "default": false
      }
    },
    "icon": {
      "element": "slot",
      "description": "Hueco del icono. Siempre presente salvo con loading.",
      "optional": false,
      "figmaLayer": "content-container › Design / blending-mode",
      "slot": {
        "key": "icon",
        "allowedComponents": [
          "Icon"
        ],
        "minItems": 1,
        "maxItems": 1,
        "mandatory": true,
        "figmaProp": "⮑ 🔄 icon"
      }
    },
    "spinner": {
      "element": "svg",
      "description": "Spinner. Solo con loading=true; sustituye al icono.",
      "optional": true,
      "figmaLayer": "content-container › Spinner (16px en size 2)"
    }
  },
  "composition": {
    "allowedChildren": null,
    "forbiddenChildren": [
      "Button",
      "IconButton",
      "a",
      "input"
    ],
    "nestedComponents": [
      {
        "part": "icon",
        "component": "Icon"
      }
    ],
    "asChild": false
  },
  "layout": {
    "height": {
      "mode": "fixed",
      "values": {
        "1": 24,
        "2": 32,
        "3": 40,
        "4": 48
      },
      "unit": "px",
      "token": "tokens.space.button-height-{size}",
      "note": "En Figma el IconButton no enlaza la altura a ninguna variable (24/32/40/48 sueltos); coincide con los tokens de altura de Button."
    },
    "width": {
      "default": "fixed",
      "modes": {
        "fixed": "Igual a la altura: siempre cuadrado. No hay hug ni fill."
      },
      "min": null,
      "max": null,
      "note": "El ancho = altura (24 / 32 / 40 / 48). Si necesitas una zona táctil mayor, ponla con padding del contenedor, no cambies el size."
    },
    "autoLayout": {
      "direction": "HORIZONTAL",
      "sizingHorizontal": "FIXED",
      "sizingVertical": "FIXED",
      "alignMain": "CENTER",
      "alignCross": "CENTER",
      "gap": "No aplica (un solo hijo)"
    },
    "iconSize": {
      "values": {
        "1": 16,
        "2": 16,
        "3": 18,
        "4": 20
      },
      "unit": "px"
    }
  },
