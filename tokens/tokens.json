{
  "$description": "DS-MOKKAPP design tokens — green / teal / blue palette. Light mode in $value; dark mode in $extensions.modes.dark. Generated from Figma DS-MOKKAPP (file: dYAgYb0igDOCarC4bFzfC7). Run: npm run tokens:build",

  "primitives": {
    "green": {
      "1": { "$type": "color", "$value": "#f0fdf4" },
      "2": { "$type": "color", "$value": "#dcfce7" },
      "3": { "$type": "color", "$value": "#bbf7d0" },
      "4": { "$type": "color", "$value": "#86efac" },
      "5": { "$type": "color", "$value": "#4ade80" },
      "6": { "$type": "color", "$value": "#22c55e" },
      "7": { "$type": "color", "$value": "#16a34a" },
      "8": { "$type": "color", "$value": "#15803d" },
      "9": { "$type": "color", "$value": "#166534" }
    },
    "teal": {
      "1": { "$type": "color", "$value": "#f0fdfa" },
      "2": { "$type": "color", "$value": "#ccfbf1" },
      "3": { "$type": "color", "$value": "#99f6e4" },
      "4": { "$type": "color", "$value": "#5eead4" },
      "5": { "$type": "color", "$value": "#2dd4bf" },
      "6": { "$type": "color", "$value": "#14b8a6" },
      "7": { "$type": "color", "$value": "#0d9488" },
      "8": { "$type": "color", "$value": "#0f766e" },
      "9": { "$type": "color", "$value": "#115e59" }
    },
    "blue": {
      "1": { "$type": "color", "$value": "#eff6ff" },
      "2": { "$type": "color", "$value": "#dbeafe" },
      "3": { "$type": "color", "$value": "#bfdbfe" },
      "4": { "$type": "color", "$value": "#93c5fd" },
      "5": { "$type": "color", "$value": "#60a5fa" },
      "6": { "$type": "color", "$value": "#3b82f6" },
      "7": { "$type": "color", "$value": "#2563eb" },
      "8": { "$type": "color", "$value": "#1d4ed8" },
      "9": { "$type": "color", "$value": "#1e40af" }
    },
    "neutral": {
      "1":  { "$type": "color", "$value": "#fafafa" },
      "2":  { "$type": "color", "$value": "#f4f4f5" },
      "3":  { "$type": "color", "$value": "#e4e4e7" },
      "4":  { "$type": "color", "$value": "#d4d4d8" },
      "5":  { "$type": "color", "$value": "#a1a1aa" },
      "6":  { "$type": "color", "$value": "#71717a" },
      "7":  { "$type": "color", "$value": "#52525b" },
      "8":  { "$type": "color", "$value": "#3f3f46" },
      "9":  { "$type": "color", "$value": "#27272a" },
      "10": { "$type": "color", "$value": "#18181b" },
      "11": { "$type": "color", "$value": "#09090b" }
    }
  },

  "color": {
    "background": {
      "$type": "color",
      "$value": "#fafafa",
      "$extensions": { "modes": { "light": "#fafafa", "dark": "#09090b" } }
    },
    "foreground": {
      "$type": "color",
      "$value": "#09090b",
      "$extensions": { "modes": { "light": "#09090b", "dark": "#fafafa" } }
    },
    "primary": {
      "$type": "color",
      "$value": "#22c55e",
      "$extensions": { "modes": { "light": "#22c55e", "dark": "#4ade80" } }
    },
    "primary-foreground": {
      "$type": "color",
      "$value": "#fafafa",
      "$extensions": { "modes": { "light": "#fafafa", "dark": "#09090b" } }
    },
    "secondary": {
      "$type": "color",
      "$value": "#14b8a6",
      "$extensions": { "modes": { "light": "#14b8a6", "dark": "#2dd4bf" } }
    },
    "secondary-foreground": {
      "$type": "color",
      "$value": "#fafafa",
      "$extensions": { "modes": { "light": "#fafafa", "dark": "#09090b" } }
    },
    "accent": {
      "$type": "color",
      "$value": "#3b82f6",
      "$extensions": { "modes": { "light": "#3b82f6", "dark": "#60a5fa" } }
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "#fafafa",
      "$extensions": { "modes": { "light": "#fafafa", "dark": "#09090b" } }
    },
    "muted": {
      "$type": "color",
      "$value": "#f4f4f5",
      "$extensions": { "modes": { "light": "#f4f4f5", "dark": "#27272a" } }
    },
    "muted-foreground": {
      "$type": "color",
      "$value": "#71717a",
      "$extensions": { "modes": { "light": "#71717a", "dark": "#a1a1aa" } }
    },
    "card": {
      "$type": "color",
      "$value": "#fafafa",
      "$extensions": { "modes": { "light": "#fafafa", "dark": "#18181b" } }
    },
    "card-foreground": {
      "$type": "color",
      "$value": "#09090b",
      "$extensions": { "modes": { "light": "#09090b", "dark": "#fafafa" } }
    },
    "border": {
      "$type": "color",
      "$value": "#e4e4e7",
      "$extensions": { "modes": { "light": "#e4e4e7", "dark": "#3f3f46" } }
    },
    "input": {
      "$type": "color",
      "$value": "#e4e4e7",
      "$extensions": { "modes": { "light": "#e4e4e7", "dark": "#3f3f46" } }
    },
    "ring": {
      "$type": "color",
      "$value": "#22c55e",
      "$extensions": { "modes": { "light": "#22c55e", "dark": "#4ade80" } }
    },
    "destructive": {
      "$type": "color",
      "$value": "#ef4444",
      "$extensions": { "modes": { "light": "#ef4444", "dark": "#7f1d1d" } }
    },
    "destructive-foreground": {
      "$type": "color",
      "$value": "#fafafa"
    }
  },

  "spacing": {
    "1":  { "$type": "dimension", "$value": "0.25rem" },
    "2":  { "$type": "dimension", "$value": "0.5rem" },
    "3":  { "$type": "dimension", "$value": "0.75rem" },
    "4":  { "$type": "dimension", "$value": "1rem" },
    "5":  { "$type": "dimension", "$value": "1.25rem" },
    "6":  { "$type": "dimension", "$value": "1.5rem" },
    "8":  { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" }
  },

  "radius": {
    "sm":   { "$type": "dimension", "$value": "0.125rem" },
    "md":   { "$type": "dimension", "$value": "0.375rem" },
    "lg":   { "$type": "dimension", "$value": "0.5rem" },
    "xl":   { "$type": "dimension", "$value": "0.75rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },

  "font": {
    "size": {
      "xs":   { "$type": "dimension", "$value": "0.75rem" },
      "sm":   { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "lg":   { "$type": "dimension", "$value": "1.125rem" },
      "xl":   { "$type": "dimension", "$value": "1.25rem" },
      "2xl":  { "$type": "dimension", "$value": "1.5rem" },
      "3xl":  { "$type": "dimension", "$value": "1.875rem" },
      "4xl":  { "$type": "dimension", "$value": "2.25rem" }
    },
    "weight": {
      "normal":   { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "leading": {
      "none":    { "$type": "dimension", "$value": "1" },
      "tight":   { "$type": "dimension", "$value": "1.25" },
      "normal":  { "$type": "dimension", "$value": "1.5" },
      "relaxed": { "$type": "dimension", "$value": "1.625" }
    }
  },

  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": [{ "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#00000014", "inset": false }]
    },
    "md": {
      "$type": "shadow",
      "$value": [
        { "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-1px", "color": "#0000001a", "inset": false },
        { "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-2px", "color": "#0000001a", "inset": false }
      ]
    },
    "lg": {
      "$type": "shadow",
      "$value": [
        { "offsetX": "0px", "offsetY": "10px", "blur": "15px", "spread": "-3px", "color": "#0000001a", "inset": false },
        { "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-4px", "color": "#0000001a", "inset": false }
      ]
    }
  }
}
